@using MudBlazor
@using RescueAnimalDashboard.Web.Services.State
@implements IDisposable
@inject DashboardState State

<MudChart
    T="int" 
    ChartType="ChartType.Bar"
    ChartSeries="@_series" 
    ChartLabels="@_xAxisLabels"
    ChartOptions="@_options"
    Width="100%" Height="100%" />

@code {
    private const int NumberOfRecords = 25;

    private string?[] _breedNames = [];
    private int[] _breedCounts = [];

    private readonly BarChartOptions _options = new()
    { 
        ShowValues = true,
        XAxisTitle = $"Breeds in selected data (top {DashboardState.ChartBreedCountLimit})",
        YAxisTitle = "Number of animals in data",
        XAxisLabelRotation = 60,
        ShowLegend = false,
        BarWidthRatio = .8,
    };

    private readonly List<ChartSeries<int>> _series =
    [
        new() {}
    ];

    private string?[] _xAxisLabels = { };

    protected override async Task OnInitializedAsync()
    {
        State.OnChange += HandleDashboardStateHasChanged;
        CountBreeds();
    }

    public void Dispose()
    {
        State.OnChange -= StateHasChanged;
    }

    private void HandleDashboardStateHasChanged()
    {
        _ = InvokeAsync(() =>
        {
            CountBreeds();
            StateHasChanged();
        });
    }

    private void CountBreeds()
    {
        // Set chart data and labels
        _xAxisLabels = State.BreedCounts
            .Select(b => b.Name)
            .ToArray();

        _series[0].Data = State.BreedCounts
            .Select(b => b.Count)
            .ToArray();
    }
}
