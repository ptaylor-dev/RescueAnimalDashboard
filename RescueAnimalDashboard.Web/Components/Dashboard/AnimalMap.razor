
@using RescueAnimalDashboard.Domain.ValueObjects
@using static LeafletForBlazor.techs.maps.Leaflet

@if (_interactive)
{
    <div class="d-flex flex-wrap mt-4">
        <div class="align-self-center d-inline">Selected Animal: @SelectedAnimal?.AnimalId</div>
    </div>
    <Map @ref="_map"
         loadParameters="@loadParameters"
         height="calc(80vh - 2rem)"
         width="calc(80vw - 2rem)" />
}
else
{
    <p>Loading map...</p>
}

@code {
    Map? _map = null;
    private bool _interactive;

    [Parameter]
    public Animal? SelectedAnimal { get; set; }
    private Animal? _lastAnimalSelected;

    private readonly LoadParameters loadParameters = new()
    {
        location = new Location
        {
            latitude = 30.75,
            longitude = -97.48
        },
        zoomLevel = 10,
        mapControls = new MapControls
        {
            layerList = new LayerList
            {
                position = Position.topRight
            },
            scaleBar = new ScaleBar
            {
                position = Position.bottomRight,
                unitOfScaleBar = UnitOfScaleBar.imperial
            }
        }
    };


    protected override async Task OnParametersSetAsync()
    {
        await TryShowSelectedAnimalAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await TryShowSelectedAnimalAsync();

        _interactive = true;
        StateHasChanged();
    }

    private async Task TryShowSelectedAnimalAsync()
    {
        if (!_interactive || _map is null || SelectedAnimal is null)
            return;

        if (SelectedAnimal == _lastAnimalSelected)
            return;

        _lastAnimalSelected = SelectedAnimal;

        if (!TryGetCoordinates(SelectedAnimal, out double latitude, out double longitude))
            return;

        await AddMarkerAsync(latitude, longitude);
    }

    private static bool TryGetCoordinates(Animal animal, out double latitude, out double longitude)
    {
        // Initialize output variables
        latitude = animal.Latitude;
        longitude = animal.Longitude;

        return latitude is >= -90 and <= 90 && longitude is >= -180 and <= 180;
    }

    private async Task AddMarkerAsync(double latitude, double longitude)
    {
        var animalcoordinates = new Coordinates()
            {
                xy = new double[2] { latitude, longitude }
            };
        var animalPoint = new StreamPoint()
            {
                coordinates = animalcoordinates
            };

        // TODO - This does not remove the points from the map, just from the list of points. Need to figure out how to remove points from map!!
        await _map?.Geometric?.Points.Remove()!;

        await _map?.Geometric?.Points.Add(new List<StreamPoint>() { animalPoint })!;


    }
}
