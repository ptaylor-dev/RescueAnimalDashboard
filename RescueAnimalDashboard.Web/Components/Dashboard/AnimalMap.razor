@using Microsoft.JSInterop
@using RescueAnimalDashboard.Domain.ValueObjects
@implements IAsyncDisposable
@inject IJSRuntime JS

<div id="@_mapElementId" class="animal-map"></div>


@code {
    // Constants
    private const double DefaultLatitude = 30.75;
    private const double DefaultLongitude = -97.48;
    private const int DefaultZoom = 10;

    [Parameter]
    public Animal? SelectedAnimal { get; set; }
    private Animal? _lastAnimalSelected;

    private readonly string _mapElementId = $"animal-map-{Guid.NewGuid():N}";   // Generates unique ID

    private IJSObjectReference? _mapModule;
    private bool _mapInitialized;


    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Load JavaScript module on first render
        if (firstRender)
        {
            _mapModule = await JS.InvokeAsync<IJSObjectReference>(
                "import",
                "./js/animalMap.js");

            await _mapModule.InvokeVoidAsync(
                "initialize",
                _mapElementId,
                DefaultLatitude,
                DefaultLongitude,
                DefaultZoom);

            _mapInitialized = true;
        }

        if (_mapInitialized && !ReferenceEquals(SelectedAnimal, _lastAnimalSelected))
        {
            await UpdateSelectedAnimalMarkerAsync();
        }
    }

    private async Task UpdateSelectedAnimalMarkerAsync()
    {
        if (_mapModule is null || ReferenceEquals(SelectedAnimal, _lastAnimalSelected))
            return;

        _lastAnimalSelected = SelectedAnimal;

        if (SelectedAnimal is null || !SelectedAnimal.HasValidCoordinates)
        {
            // Clear marker if nothing selected
            await _mapModule.InvokeVoidAsync("clearSelectedAnimal", _mapElementId);
            return;
        }

        await AddMarkerAsync();
    }

    private async Task AddMarkerAsync()
    {
        if (_mapModule is null || SelectedAnimal is null)
            return;

        var title = SelectedAnimal.Name ?? SelectedAnimal.AnimalId;

        // Adds popup with animal info
        var popupHtml = $"""
            <strong>{System.Net.WebUtility.HtmlEncode(SelectedAnimal.Name ?? "Unnamed animal")}</strong><br>
            ID: {System.Net.WebUtility.HtmlEncode(SelectedAnimal.AnimalId)}<br>
            Breed: {System.Net.WebUtility.HtmlEncode(SelectedAnimal.Breed ?? "unknown")}
            """;

        await _mapModule.InvokeVoidAsync(
            "setSelectedAnimal",
            _mapElementId,
            SelectedAnimal.Latitude,
            SelectedAnimal.Longitude,
            title,
            popupHtml
        );
    }

    public async ValueTask DisposeAsync()
    {
        if (_mapModule is null)
        {
            return;
        }

        try
        {

            await _mapModule.InvokeVoidAsync("dispose", _mapElementId);
            await _mapModule.DisposeAsync();
        }
        catch(JSDisconnectedException)
        {
            // If the browser/Blazor runtime is already shutting down no JS cleanup can occur
        }
    }
}
