@using MudBlazor
@using RescueAnimalDashboard.Application.Models
@using RescueAnimalDashboard.Domain.Models
@using RescueAnimalDashboard.Web.Services.Api
@using RescueAnimalDashboard.Web.Services.State

@implements IDisposable

@inject DashboardState State
@inject IAnimalApiClient AnimalApi
@inject ILogger<AnimalTable> Logger

<MudTable T="Animal"
          Class="animal-table"
          @ref="_table"
          ServerData="LoadAnimals"
          RowsPerPage="10"
          FixedHeader="true"
          FixedFooter="true"
          Hover="true"
          Dense="true"
          Striped="true"
          SelectedItem="@State.SelectedAnimal"
          SelectedItemChanged="OnSelectedAnimalChanged"
          Height="400px">
    <ToolBarContent>
        <RescueTypeSelector />
        <MudSpacer />
        <!-- Debouncing keeps the server from being called after every key stroke -->
        <MudTextField T="string"
            Value="@State.SearchString"
            ValueChanged="OnSearchChanged"
            Immediate="true"
            DebounceInterval="300"
            Placeholder="Search"
            Adornment="Adornment.Start"
            AdornmentIcon="@Icons.Material.Filled.Search"
            IconSize="Size.Medium"
            Class="mt-0" />
    </ToolBarContent>    
    <HeaderContent>
        <MudTh><MudTableSortLabel T="Animal" SortLabel="AnimalId" InitialDirection="SortDirection.Ascending">Animal ID</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="Animal" SortLabel="Type">Type</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="Animal" SortLabel="Breed">Breed</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="Animal" SortLabel="Color">Color</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="Animal" SortLabel="DateOfBirth">Date Of Birth</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="Animal" SortLabel="DateTime">DateTime</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="Animal" SortLabel="Name">Name</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="Animal" SortLabel="OutcomeType">Outcome Type</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="Animal" SortLabel="OutcomeSubtype">Outcome Subtype</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="Animal" SortLabel="SexUponOutcome">Sex Upon Outcome</MudTableSortLabel></MudTh>
        <MudTh><MudTableSortLabel T="Animal" SortLabel="AgeUponOutcome">Age Upon Outcome</MudTableSortLabel></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Animal ID">@context.AnimalId</MudTd>
            <MudTd DataLabel="Type">@context.Type</MudTd>
            <MudTd DataLabel="Breed">@context.Breed</MudTd>
            <MudTd DataLabel="Color">@context.Color</MudTd>
            <MudTd DataLabel="Date of Birth">@context.DateOfBirth</MudTd>
            <MudTd DataLabel="DateTime">@context.DateTime</MudTd>
            <MudTd DataLabel="Name">@context.Name</MudTd>
            <MudTd DataLabel="Outcome Type">@context.OutcomeType</MudTd>
            <MudTd DataLabel="Outcome Subtype">@context.OutcomeSubtype</MudTd>
            <MudTd DataLabel="Sex Upon Outcome">@context.SexUponOutcome</MudTd>
            <MudTd DataLabel="Age Upon Outcome">@context.AgeUponOutcome</MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager PageSizeOptions="new int[] { 10, 25, 50, 100 }" />
        </PagerContent>
    </MudTable>

@code {
    private readonly int[] _pageSizeOptions = [10, 25, 50, 100];

    private MudTable<Animal>? _table;
    private string? _errorMessage;
    private long _loadVersion;
    private bool _disposed;

    [Parameter]
    public EventCallback<Animal?> SelectedAnimalChanged { get; set; }

    protected override void OnInitialized()
    {
        State.FiltersChanged += OnFiltersChangedAsync;
    }

    private Task OnSearchChanged(string? value)
    {
        return State.SetSearchStringAsync(value);
    }

    private async Task OnSelectedAnimalChanged(Animal? animal)
    {
        State.SetSelectedAnimal(animal);

        await SelectedAnimalChanged.InvokeAsync(animal);
    }

    private Task OnFiltersChangedAsync()
    {
        return InvokeAsync(async () =>
        {
            if (_disposed || _table is null)
                return;

            if (_table.CurrentPage != 0)
            {
                // Changing pages causes the table to request server data.
                _table.NavigateTo(0);
            }
            else
            {
                // Already on page zero: explicitly reload it.
                await _table.ReloadServerData();
            }
        });
    }

    private async Task<TableData<Animal>> LoadAnimals(TableState tableState, CancellationToken ct)
    {
        var loadVersion = ++_loadVersion;

        _errorMessage = null;

        // Define no-sort behavior
        var hasSort = tableState.SortDirection != SortDirection.None;

        var query = new AnimalQuery(
            rescueType: State.RescueCategory,
            searchText: State.SearchString,
            sortBy: hasSort
                ? ToSortOption(tableState.SortLabel)
                : AnimalSortOption.AnimalId,
            sortBySecondary: State.SecondarySortOption,
            sortAscending: !hasSort ||
                tableState.SortDirection == SortDirection.Ascending,
            pageIndex: tableState.Page,
            pageSize: tableState.PageSize,
            breedCountLimit: DashboardState.ChartBreedCountLimit);

        try
        {
            var response = await AnimalApi.GetAnimalsAsync(query, ct);

            ct.ThrowIfCancellationRequested();

            if (!_disposed && loadVersion == _loadVersion)
            {
                State.UpdatePage(query, response);
            }

            return new TableData<Animal>
            {
                Items = response.Animals,
                TotalItems = response.TotalCount
            };
        }
        catch (OperationCanceledException)
        {
            // Cancellation is not an API failure.
            throw;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load the animal table.");

            if (!_disposed && loadVersion == _loadVersion)
            {
                _errorMessage = "Unable to load animals. Please try again.";
            }

            return new TableData<Animal>
            {
                Items = Array.Empty<Animal>(),
                TotalItems = 0
            };
        }
    }

    private static AnimalSortOption ToSortOption(string? sortLabel)
    {
        return sortLabel switch
        {
            "AnimalId" => AnimalSortOption.AnimalId,
            "Type" => AnimalSortOption.Type,
            "Breed" => AnimalSortOption.Breed,
            "Color" => AnimalSortOption.Color,
            "DateOfBirth" => AnimalSortOption.DateOfBirth,
            "DateTime" => AnimalSortOption.DateTime,
            "Name" => AnimalSortOption.Name,
            "OutcomeType" => AnimalSortOption.OutcomeType,
            "OutcomeSubtype" => AnimalSortOption.OutcomeSubtype,
            "SexUponOutcome" => AnimalSortOption.SexUponOutcome,
            "AgeUponOutcomeInWeeks" =>
                AnimalSortOption.AgeUponOutcomeInWeeks,
            _ => AnimalSortOption.AnimalId
        };
    }

    public void Dispose()
    {
        _disposed = true;
        State.FiltersChanged -= OnFiltersChangedAsync;
    }
}
