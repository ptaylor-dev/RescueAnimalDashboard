@using MudBlazor
@using RescueAnimalDashboard.Domain.Models
@using RescueAnimalDashboard.Web.Services.State
@inject DashboardState State

<MudChipSet T="RescueCategory" 
            SelectedValue="@State.RescueCategory" 
            SelectedValueChanged="OnRescueCategoryChanged"
            CheckMark="true"
            SelectionMode="SelectionMode.ToggleSelection">
    <MudChip Color="Color.Primary" Value="@(RescueCategory.Water)">Water Rescue</MudChip>
    <MudChip Color="Color.Primary" Value="@(RescueCategory.Mountain)">Mountain/Wilderness Rescue</MudChip>
    <MudChip Color="Color.Primary" Value="@(RescueCategory.Disaster)">Disaster/Individual Tracking</MudChip>
</MudChipSet>

<MudText>
    @(State.RescueCategory == RescueCategory.None
    ? "No rescue criteria selected."
    : $"Filtering by {State.RescueCategory.ToString().ToLower()} rescue criteria.")
</MudText>

@code {
    // TODO - Set colors for project

    private Task OnRescueCategoryChanged(RescueCategory category)
    {
        return State.SetRescueCategoryAsync(category);
    }
}
