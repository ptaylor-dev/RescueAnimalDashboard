@page "/dashboard"
<!-- Interactive mode needed to keep component from rendering as static SSR -->
@rendermode InteractiveServer

@using RescueAnimalDashboard.Web.Components.Dashboard
@using RescueAnimalDashboard.Web.Services.State
@inject AppState State

<h3>Dashboard</h3>

<AnimalTable
    Animals="State.FilteredAnimals"
    @bind-SelectedAnimal="State.SelectedAnimal"/>
<div class="d-flex">
    <div class="col-sm-12 col-md-6">
        <AnimalBreedChart />
    </div>
    <div class="col-sm-12 col-md-6">
        <AnimalMap SelectedAnimal="State.SelectedAnimal" />
    </div>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        await State.LoadAsync();
    }
}
