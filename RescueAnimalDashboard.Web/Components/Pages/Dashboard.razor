@page "/dashboard"
@using System.Net.Http.Json
@using RescueAnimalDashboard.Domain.ValueObjects
@inject IHttpClientFactory ClientFactory

<h3>Dashboard</h3>

@if (_animalList == null)
{
    <p><em>Loading data from API...</em></p>
}
else if (_animalList.Count == 0)
{
    <p>No animals found</p>
}
else
{
    <p>@_animalList[0].AnimalId</p>
}

@code {
    private List<Animal>? _animalList;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var client = ClientFactory.CreateClient("RescueAnimalAPI");

            _animalList = await client.GetFromJsonAsync<List<Animal>>("animals");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching data: {ex.Message.ToString()}");
        }
    }
}
