@page "/"
@implements IDisposable

@using RescueAnimalDashboard.Domain.Models
@using RescueAnimalDashboard.Web.Components.Dashboard
@using RescueAnimalDashboard.Web.Services.State
@inject DashboardState State

<h3>Dashboard</h3>

<AnimalTable
    SelectedAnimalChanged="OnSelectedAnimalChanged"/>
<div class="d-flex">
    <div class="col-sm-12 col-md-6">
        <AnimalBreedChart />
    </div>
    <div class="col-sm-12 col-md-6">
        <AnimalMap SelectedAnimal="State.SelectedAnimal" />
    </div>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        State.OnChange += StateHasChanged;
        //await State.LoadAsync();
    }

    public void Dispose()
    {
        State.OnChange -= StateHasChanged;
    }

    private void OnSelectedAnimalChanged(Animal? animal)
    {
        State.SetSelectedAnimal(animal);
    }
}
